__MACOSX/

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# SwiftLint (keep .swiftlint.yml; ignore generated reports)
swiftlint_report.*

# Local Hermes attachments (large installers) + worktrees
.hermes/
.worktrees/

# Local research raw data (captions, scrapes) — never commit
research/raw/

# Python bytecode
**/__pycache__/
*.py[cod]

# Packaged app builds (regenerate with scripts/package_app.sh)
# Track the downloadable zip; ignore the regenerable unpacked .app.
dist/*.app
dist/*.app.zip
scripts/ax_act_bin
